# See README.md for local setup and value sources.
# Client-exposed (NEXT_PUBLIC_*) values are safe in the browser bundle.
# Server-only values must never leak to the client.

# Supabase (client + server)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server only)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Application base URL — used for invite redirect target
APP_URL=http://localhost:3000

# Cron endpoint protection
CRON_SECRET=

# Developer QA remote fixture (server-side scripts only).
# Local mode reads keys from `supabase status` and needs none of these values.
# Comma-separated remote project refs explicitly allowed for destructive QA reset.
DURE_QA_ALLOWED_PROJECT_REFS=
DURE_QA_WORKSPACE_ID=
DURE_QA_PASSWORD=
DURE_QA_OWNER_EMAIL=dure.qa.owner@test.local
DURE_QA_GROUP_ADMIN_EMAIL=dure.qa.group@test.local
DURE_QA_INSTRUCTOR_EMAIL=dure.qa.instructor@test.local
DURE_QA_APP_URL=
