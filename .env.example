# See docs/environment.md §3 for value sources.
# Client-exposed (NEXT_PUBLIC_*) values are safe in the browser bundle.
# Server-only values must never leak to the client.

# Supabase (client + server)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server only)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Application base URL — used for invite redirect target
APP_URL=http://localhost:3000

# Cron endpoint protection
CRON_SECRET=
